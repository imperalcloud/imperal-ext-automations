    {
      "name": "create_automation",
      "description": "Create a new automation rule from rules.available_events skeleton.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:automation"
      ],
      "id_projection": "",
      "params_schema": {
        "$defs": {
          "StructuredAction": {
            "description": "WS2 grounded action — the resolved (app_id, tool, args) the rule runs.\nOptional on create: when present the GW persists it instead of free text.",
            "properties": {
              "app_id": {
                "description": "Extension that owns the tool, from the user's live scope",
                "title": "App Id",
                "type": "string"
              },
              "tool": {
                "description": "@chat.function name the user can actually invoke",
                "title": "Tool",
                "type": "string"
              },
              "args": {
                "additionalProperties": true,
                "description": "Well-formed args for the tool",
                "title": "Args",
                "type": "object"
              }
            },
            "required": [
              "app_id",
              "tool"
            ],
            "title": "StructuredAction",
            "type": "object"
          }
        },
        "description": "Create a new automation rule.",
        "properties": {
          "event_type": {
            "description": "Trigger event from rules.available_events skeleton (e.g. email.received, notes.created, system.scheduled)",
            "title": "Event Type",
            "type": "string"
          },
          "action_description": {
            "description": "What to do when triggered, in natural language",
            "title": "Action Description",
            "type": "string"
          },
          "schedule": {
            "default": "",
            "description": "Cron expression (system.scheduled only)",
            "title": "Schedule",
            "type": "string"
          },
          "cooldown_seconds": {
            "default": 60,
            "description": "Min seconds between triggers",
            "title": "Cooldown Seconds",
            "type": "integer"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/$defs/StructuredAction"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Resolved (app_id, tool, args) for grounded persistence (WS2). Omit to keep NL action."
          },
          "notify_mode": {
            "default": "all",
            "description": "Run notifications (bell + chat): 'all' (default) / 'failures' / 'off'.",
            "title": "Notify Mode",
            "type": "string"
          }
        },
        "required": [
          "event_type",
          "action_description"
        ],
        "title": "CreateAutomationParams",
        "type": "object"
      },
      "return_schema": {
